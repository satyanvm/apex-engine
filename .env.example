# ./apex up creates .env for you. Copy this file only to configure by hand.

# Required
POSTGRES_PASSWORD=
# base64 of 32 random bytes: openssl rand -base64 32
APEX_SECRET_KEY=
# key:tenant pairs, comma separated. Keys need 16+ characters: openssl rand -hex 24
# These are each tenant's administrator. Make keys with narrower roles for people
# and systems with: apexctl keys add <name> --role viewer|approver|editor|operator
APEX_API_KEYS=

# For a product with its own customers: one key that acts for any tenant. Each
# request names the tenant in X-Apex-Tenant and may name the end user in
# X-Apex-Actor and their role in X-Apex-Role. 32+ characters: openssl rand -hex 24
# Set this, APEX_API_KEYS, or both. Keep it on your server.
# APEX_PLATFORM_KEY=

# A model, to compile prompts. Set any one; each tier defaults to its provider.
# Without one the engine still runs saved workflows that have no AI steps.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Override the models (the provider follows the name)
# PLANNER_MAP_MODEL=claude-haiku-5-5   # cheap: picks relevant tools
# PLANNER_MODEL=claude-opus-5-5        # strong: writes the graph
# APEX_AGENT_MODEL=claude-haiku-5-5    # runs agent.llm steps
#
# Any OpenAI-compatible server (OpenRouter, Groq, LM Studio, vLLM):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# PLANNER_MODEL=openai/<model>
# PLANNER_MAP_MODEL=openai/<model>
#
# A local Ollama model, no key:
# PLANNER_MODEL=ollama/qwen3:8b
# PLANNER_MAP_MODEL=ollama/qwen3:8b

# Tell someone when a run needs a human: a Slack-style incoming webhook URL
# APEX_NOTIFY_WEBHOOK=
# Public address of the engine. Used for links in those messages, and as the
# address OAuth providers send people back to (<this>/oauth/callback).
# APEX_PUBLIC_URL=

# Activepieces pieces as tools. ./apex pieces sets all three for you.
# APEX_PIECES=1
# APEX_PIECES_URL=http://pieces:7391
# APEX_PIECES_TOKEN=          # shared secret between the engine and the runner: openssl rand -hex 24

# Prometheus metrics at /metrics for whoever presents this token. Empty turns them off.
# APEX_METRICS_TOKEN=

# Guard rails
# The most unfinished runs one tenant may have; the next start gets a 429.
# APEX_MAX_OPEN_RUNS=200
# Delete finished runs (with every step's stored output) and audit entries this
# many days after the fact. Unset keeps them forever.
# APEX_RETENTION_DAYS=90
# APEX_AUDIT_RETENTION_DAYS=365
# "deletes": refuse any graph that deletes with no approval step before the
# delete. "changes": refuse any change made that way. Compiles add the approval.
# APEX_REQUIRE_APPROVAL=deletes

# Public hostname for automatic HTTPS (docker-compose.prod.yml only)
DOMAIN=

# Serve the optional web inspector at /
# APEX_CONSOLE=1

# Other
# APEX_PORT=8700
# APEX_COMPILE_RPM=30
# APEX_ROLE=all            # all, api or worker
# APEX_ALLOW_PRIVATE_NETWORK=0   # 1 lets nodes call private addresses: local development only
