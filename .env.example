# Required
GEMINI_API_KEY=
# base64 of 32 random bytes: openssl rand -base64 32
APEX_SECRET_KEY=
# key:tenant pairs, comma separated. Keys need 16+ characters: openssl rand -hex 24
APEX_API_KEYS=
POSTGRES_PASSWORD=
# Public hostname for automatic HTTPS (docker-compose.prod.yml only)
DOMAIN=

# Optional
# PLANNER_MAP_MODEL=gemini-3.1-flash-lite
# PLANNER_MODEL=gemini-3.5-flash
# APEX_AGENT_MODEL=gemini-3.1-flash-lite
# APEX_COMPILE_RPM=30
# APEX_ROLE=all            # all, api or worker
# APEX_ALLOW_PRIVATE_NETWORK=0   # 1 lets nodes call private addresses: local development only
